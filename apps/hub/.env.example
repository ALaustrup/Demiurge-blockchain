# QOR Auth Service URL
# The qor-auth Rust service runs on port 8080 with routes at /api/v1/*
NEXT_PUBLIC_QOR_AUTH_URL=http://localhost:8080/api/v1

# Blockchain Node URL
# Local-first default: http://localhost:9944 (HTTP) / ws://localhost:9944 (WS)
NEXT_PUBLIC_RPC_URL=http://localhost:9944
NEXT_PUBLIC_DEMIURGE_RPC_URL=http://localhost:9944
NEXT_PUBLIC_BLOCKCHAIN_WS_URL=ws://localhost:9944
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:9944

# NFT Portal URL (optional; not part of the supported local-first core stack yet)
# Default port is 4000, but may use 4001 if 4000 is in use
NEXT_PUBLIC_NFT_PORTAL_URL=http://localhost:4001

# Environment
NODE_ENV=development

# Stripe Payment Processing
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Subscription Price IDs (create in Stripe Dashboard as bi-weekly recurring)
STRIPE_PRICE_SUB_TIER_1=price_supporter_biweekly
STRIPE_PRICE_SUB_TIER_2=price_champion_biweekly
STRIPE_PRICE_SUB_TIER_3=price_guardian_biweekly
STRIPE_PRICE_SUB_TIER_4=price_archon_biweekly
STRIPE_PRICE_SUB_TIER_5=price_godsent_biweekly

# Webhook internal secret (for server-to-server calls)
WEBHOOK_INTERNAL_SECRET=your-internal-secret

# Treasury for CGT distributions
# TREASURY_SEED is the mnemonic phrase for the treasury account (server-side only)
# Keep this secret and never commit to version control!
TREASURY_SEED=your twelve word mnemonic phrase here for treasury account
TREASURY_ADDRESS=0x0000000000000000000000000000000000000001

# Server-side qor-auth base URL used by API routes/middleware to validate tokens.
# Accepts either http://host:8080 or http://host:8080/api/v1. Falls back to
# NEXT_PUBLIC_QOR_AUTH_URL when unset.
QOR_AUTH_URL=

# Admin API keys accepted by /api/nft/mint and /api/nft/update via `x-api-key`.
# Comma-separated, server-side only. Leave empty to disable API-key access
# entirely (bearer tokens with admin/god role still work). Never ship to the browser.
NFT_ADMIN_API_KEYS=
