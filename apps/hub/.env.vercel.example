# Copy to Vercel Project → Settings → Environment Variables (Production + Preview)

# Public (browser) — local Studio defaults. Do not point at retired OVH.
NEXT_PUBLIC_QOR_AUTH_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_BLOCKCHAIN_WS_URL=ws://localhost:9944
NEXT_PUBLIC_DEMIURGE_RPC_URL=http://localhost:9944
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:9944
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server — Neon (new project demiurge-studio) or local Docker Postgres
DATABASE_URL=postgresql://qor_auth:demiurge_qor_auth_dev@127.0.0.1:5432/qor_auth

# Server — QOR Auth + local node
QOR_AUTH_URL=http://localhost:8080
DEMIURGE_RPC_URL=http://localhost:9944

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media (required on Vercel — no local disk fallback)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Optional AI / IPFS fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INFURA_IPFS_PROJECT_ID=
INFURA_IPFS_PROJECT_SECRET=
WEB3_STORAGE_TOKEN=
