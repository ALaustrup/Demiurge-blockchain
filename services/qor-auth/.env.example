# Qor Auth Service Configuration
# Copy to .env and fill in values

# Server
QOR_AUTH__SERVER__HOST=0.0.0.0
QOR_AUTH__SERVER__PORT=8080
RUN_ENV=development

# Database (PostgreSQL 18)
QOR_AUTH__DATABASE__URL=postgres://qor_auth:demiurge_qor_auth_dev@localhost:5432/qor_auth
QOR_AUTH__DATABASE__MAX_CONNECTIONS=10

# Redis
QOR_AUTH__REDIS__URL=redis://localhost:6379

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
QOR_AUTH__JWT__ACCESS_SECRET=your-super-secret-access-key-change-in-production
QOR_AUTH__JWT__REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
QOR_AUTH__JWT__ACCESS_EXPIRY_SECS=900
QOR_AUTH__JWT__REFRESH_EXPIRY_SECS=2592000
QOR_AUTH__JWT__ISSUER=qor-auth

# Security
QOR_AUTH__SECURITY__MAX_LOGIN_ATTEMPTS=5
QOR_AUTH__SECURITY__LOCKOUT_DURATION_SECS=900
QOR_AUTH__SECURITY__MAX_SESSIONS=10
QOR_AUTH__SECURITY__PASSWORD_MIN_LENGTH=12

# Blockchain RPC (starter CGT mint on register)
BLOCKCHAIN_RPC_URL=http://localhost:9944

# Demiurge Studio — offline registration + CD-key licensing
STUDIO_MODE=true
STUDIO_REQUIRE_LICENSE=false
STUDIO_LICENSE_ADMIN_SECRET=change-me-before-generating-keys

# Feature flags
# Starter CGT grant on registration (balances_claimStarter RPC is being removed; keep false)
# TODO(phase-1): starter grants must become a signed treasury transaction.
QOR_AUTH__FEATURES__STARTER_GRANT_ENABLED=false

# CORS: comma-separated browser origins (defaults to localhost:3000/5173 when unset)
QOR_AUTH__SERVER__CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin bootstrap (replaces the removed migration seed). If set and no god-role
# user exists at startup, creates godmode#0001 with this password (Argon2id)
# and logs a warning. Unset after first start.
# QOR_AUTH_BOOTSTRAP_GOD_PASSWORD=
