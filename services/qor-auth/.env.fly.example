# Set via: fly secrets set KEY=value -a demiurge-qor-auth
# Generate JWT secrets: openssl rand -hex 32

QOR_AUTH__DATABASE__URL=postgresql://USER:PASS@HOST-pooler.neon.tech/qor_auth?sslmode=require
QOR_AUTH__REDIS__URL=rediss://default:TOKEN@HOST.upstash.io:6379
QOR_AUTH__JWT__ACCESS_SECRET=
QOR_AUTH__JWT__REFRESH_SECRET=
QOR_AUTH__JWT__ISSUER=qor-auth
QOR_AUTH__JWT__ACCESS_EXPIRY_SECS=900
QOR_AUTH__JWT__REFRESH_EXPIRY_SECS=2592000
SUBSTRATE_RPC_URL=wss://rpc.demiurge.cloud

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@demiurge.cloud
